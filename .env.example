# Modelo de configuração do banco de dados PostgreSQL
# Copie este arquivo para ".env" e preencha com seus dados reais.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=controle_financeiro
DB_USER=postgres
DB_PASSWORD=

# Endereços do front-end que podem acessar a API (separados por vírgula)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:4200
